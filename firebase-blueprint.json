{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User account preferences and profile metadata.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "email": {
          "type": "string",
          "minLength": 3,
          "maxLength": 200
        },
        "preferredLanguage": {
          "type": "string",
          "enum": ["ar", "en"],
          "maxLength": 10
        },
        "preferredTheme": {
          "type": "string",
          "enum": ["dark", "light", "futuristic"],
          "maxLength": 20
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "displayName", "email", "preferredLanguage", "preferredTheme", "createdAt", "updatedAt"]
    },
    "Conversation": {
      "title": "Conversation",
      "description": "A user's saved AI conversation or analysis session.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "mode": {
          "type": "string",
          "enum": ["chat", "docs", "canvas", "audio"],
          "maxLength": 20
        },
        "persona": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "lastMessagePreview": {
          "type": "string",
          "maxLength": 300
        },
        "messageCount": {
          "type": "integer"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "userId", "title", "mode", "persona", "lastMessagePreview", "messageCount", "createdAt", "updatedAt"]
    },
    "Message": {
      "title": "Message",
      "description": "An individual message inside a conversation subcollection.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "conversationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "role": {
          "type": "string",
          "enum": ["user", "assistant"],
          "maxLength": 20
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32000
        },
        "thinkingLevel": {
          "type": "string",
          "maxLength": 20
        },
        "attachmentSummary": {
          "type": "string",
          "maxLength": 300
        },
        "sources": {
          "type": "array",
          "description": "Bounded array of up to 10 grounding source objects"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "userId", "conversationId", "role", "content", "createdAt"]
    },
    "VectorDesign": {
      "title": "VectorDesign",
      "description": "Saved SVG vector artwork or diagram generated in the studio.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "prompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "svgCode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64000
        },
        "aspectRatio": {
          "type": "string",
          "enum": ["1:1", "16:9", "4:3", "3:4"],
          "maxLength": 10
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "userId", "title", "prompt", "svgCode", "aspectRatio", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private user profile and language/theme preferences, accessible only by the owner."
    },
    "/users/{userId}/conversations/{conversationId}": {
      "schema": { "$ref": "#/entities/Conversation" },
      "description": "User's saved conversations across AI workspace modes."
    },
    "/users/{userId}/conversations/{conversationId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/Message" },
      "description": "Messages belonging to a specific user conversation."
    },
    "/users/{userId}/designs/{designId}": {
      "schema": { "$ref": "#/entities/VectorDesign" },
      "description": "Saved vector graphics and diagrams created in the Vector Studio."
    }
  }
}
